<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Welcome!{% endblock %}</title>
    {% block stylesheets %}
    <link href="{{ asset('css/estilos.css') }}" rel="stylesheet" />
    {% endblock %}
</head>

<body>
    {% for label, messages in app.flashes %}
    {% for message in messages %}
    <div
        style="padding: 10px; margin: 10px 0; background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; border-radius: 4px;">
        {{ message }}
    </div>
    {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}

    {% block javascripts %}{% endblock %}
</body>

</html>