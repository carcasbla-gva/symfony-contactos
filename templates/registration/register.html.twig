{% extends 'base.html.twig' %}

{% block title %}Crear cuenta | AgendaApp{% endblock %}

{% block body %}
<div class="main-card form-card">
    <div style="text-align: center; margin-bottom: 24px;">
        <div class="brand-icon" style="width: 48px; height: 48px; margin: 0 auto 12px;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="23" y1="11" x2="17" y2="11"></line>
            </svg>
        </div>
        <h1 class="page-title" style="justify-content: center;">Crear cuenta</h1>
        <p class="page-subtitle" style="margin-bottom: 0;">Regístrate para gestionar tu agenda de contactos</p>
    </div>

    {% if form_errors(registrationForm) %}
        <div class="toast toast-danger" style="margin-bottom: 18px; position: static; animation: none;">
            <div class="toast-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
            </div>
            <div class="toast-content">{{ form_errors(registrationForm) }}</div>
        </div>
    {% endif %}

    {{ form_start(registrationForm) }}
        <div class="form-group">
            {{ form_label(registrationForm.name, 'Nombre de usuario:', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.name, {'attr': {'class': 'form-control', 'placeholder': 'Ej. Juan López'}}) }}
            {{ form_errors(registrationForm.name) }}
        </div>

        <div class="form-group">
            {{ form_label(registrationForm.email, 'Correo electrónico:', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'usuario@ejemplo.com'}}) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        <div class="form-group">
            {{ form_label(registrationForm.plainPassword, 'Contraseña:', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
            {{ form_errors(registrationForm.plainPassword) }}
        </div>

        <div class="form-group" style="display: flex; align-items: center; gap: 8px; margin-top: 14px;">
            {{ form_widget(registrationForm.agreeTerms) }}
            {{ form_label(registrationForm.agreeTerms, 'Acepto los términos y condiciones', {'label_attr': {'style': 'margin-bottom: 0; font-weight: normal; cursor: pointer;'}}) }}
        </div>

        <div style="margin-top: 24px;">
            <button type="submit" class="btn btn-primary btn-block">
                <span>Registrarme</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </div>
    {{ form_end(registrationForm) }}

    <div style="text-align: center; margin-top: 16px; font-size: 0.9rem; color: var(--slate-600);">
        ¿Ya tienes cuenta? <a href="{{ path('app_login') }}">Inicia sesión</a>
    </div>
</div>
{% endblock %}
